page {
  min-height: 100vh;
  background: #f3f7f5;
  color: #111a17;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
}

view,
text,
input,
button {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
}

.page-title {
  margin-bottom: 24rpx;
}

.eyebrow {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.page-title text.title {
  display: block;
  margin-top: 8rpx;
  color: #071916;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.08;
}

.card {
  border: 1rpx solid rgba(16, 24, 40, 0.1);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 46rpx rgba(16, 24, 40, 0.08);
}

.muted {
  color: #6a7772;
}

.primary-button,
.secondary-button {
  min-height: 88rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 88rpx;
}

.primary-button {
  background: #071916;
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid #dce7e2;
  background: #ffffff;
  color: #0f766e;
}

.form-label {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  color: #5f6e68;
  font-size: 26rpx;
  font-weight: 800;
}

.form-input {
  width: 100%;
  min-height: 80rpx;
  border: 1rpx solid #dce7e2;
  border-radius: 14rpx;
  background: #ffffff;
  color: #071916;
  font-size: 30rpx;
  font-weight: 800;
  padding: 0 22rpx;
}
