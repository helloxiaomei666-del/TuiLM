.income-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 64rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.hero-card,
.section-card,
.status-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(31, 55, 89, 0.08);
}

.eyebrow,
.status-label {
  color: #718096;
  font-size: 24rpx;
}

.page-title {
  margin-top: 8rpx;
  color: #17233d;
  font-size: 44rpx;
  font-weight: 700;
}

.page-subtitle,
.confirmation-copy,
.income-detail {
  margin-top: 12rpx;
  color: #61708a;
  font-size: 26rpx;
  line-height: 1.6;
}

.status-text {
  margin-top: 8rpx;
  color: #214f9c;
  font-size: 30rpx;
  font-weight: 600;
}

.section-title {
  color: #17233d;
  font-size: 32rpx;
  font-weight: 700;
}

.field {
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #3d4e6b;
  font-size: 26rpx;
}

.picker-value,
.input {
  min-height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dbe3f0;
  border-radius: 12rpx;
  color: #17233d;
  font-size: 28rpx;
  line-height: 76rpx;
  box-sizing: border-box;
}

.form-actions,
.income-actions {
  display: flex;
  gap: 16rpx;
}

.form-actions {
  margin-top: 28rpx;
}

.primary-action,
.secondary-action {
  flex: 1;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.primary-action {
  color: #ffffff;
  background: #2d67ca;
}

.secondary-action {
  color: #31527f;
  background: #e9f0fb;
}

.income-item {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e9edf4;
}

.income-main {
  flex: 1;
}

.income-name {
  color: #17233d;
  font-size: 29rpx;
  font-weight: 600;
}

.income-amount {
  margin-top: 8rpx;
  color: #31527f;
  font-size: 26rpx;
}

.income-actions {
  align-items: center;
}

.text-action {
  margin: 0;
  padding: 0 12rpx;
  color: #31527f;
  background: transparent;
  font-size: 25rpx;
  line-height: 1.6;
}

.danger-action {
  color: #c14343;
}

.empty-state {
  padding: 36rpx 0 12rpx;
  color: #718096;
  font-size: 28rpx;
  text-align: center;
}

.confirmation-card {
  margin-bottom: 0;
}
