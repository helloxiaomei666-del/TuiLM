.liabilities-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 64rpx;
  background: #f3f7f5;
  box-sizing: border-box;
}

.hero-card,
.section-card,
.summary-card {
  border: 1rpx solid #dce7e2;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(16, 24, 40, 0.07);
}

.hero-card,
.section-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.eyebrow {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 700;
}

.page-title {
  margin-top: 8rpx;
  color: #071916;
  font-size: 44rpx;
  font-weight: 700;
}

.page-subtitle,
.confirmation-copy,
.reminder-copy {
  display: block;
  margin-top: 12rpx;
  color: #61706a;
  font-size: 26rpx;
  line-height: 1.65;
}

.status-text {
  display: inline-block;
  margin-top: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.status-pending {
  color: #92400e;
  background: #fff7ed;
}

.status-confirmed {
  color: #0f766e;
  background: #ecfdf5;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.summary-card {
  flex: 1;
  min-width: 0;
  padding: 22rpx 16rpx;
}

.summary-label,
.summary-value {
  display: block;
}

.summary-label {
  min-height: 68rpx;
  color: #6a7772;
  font-size: 22rpx;
  line-height: 1.45;
}

.summary-value {
  margin-top: 10rpx;
  color: #071916;
  font-size: 28rpx;
  font-weight: 700;
  word-break: break-all;
}

.section-title {
  color: #17231f;
  font-size: 32rpx;
  font-weight: 700;
}

.field {
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #3d4e48;
  font-size: 26rpx;
  font-weight: 600;
}

.picker-value,
.input {
  width: 100%;
  min-height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dce7e2;
  border-radius: 12rpx;
  color: #17231f;
  background: #ffffff;
  font-size: 28rpx;
  line-height: 76rpx;
  box-sizing: border-box;
}

.inclusion-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.radio-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 72rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #dce7e2;
  border-radius: 12rpx;
  color: #263a33;
  font-size: 26rpx;
}

.form-actions,
.liability-actions {
  display: flex;
  gap: 16rpx;
}

.form-actions {
  margin-top: 28rpx;
}

.primary-action,
.secondary-action {
  flex: 1;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.primary-action {
  color: #ffffff;
  background: #0f766e;
}

.secondary-action {
  color: #0f766e;
  background: #e8f3ef;
}

.liability-item {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e7efeb;
}

.liability-main {
  flex: 1;
  min-width: 0;
}

.liability-type {
  color: #17231f;
  font-size: 29rpx;
  font-weight: 700;
}

.liability-detail,
.liability-note {
  display: block;
  margin-top: 8rpx;
  color: #52645d;
  font-size: 25rpx;
  line-height: 1.55;
}

.liability-note {
  color: #74817c;
}

.liability-actions {
  align-items: center;
}

.text-action {
  margin: 0;
  padding: 0 10rpx;
  color: #0f766e;
  background: transparent;
  font-size: 25rpx;
  line-height: 1.6;
}

.danger-action {
  color: #b33a3a;
}

.empty-state {
  padding: 40rpx 0 14rpx;
  color: #718079;
  font-size: 28rpx;
  text-align: center;
}

.reminder-card {
  background: #f8fbfa;
}

.confirmation-card {
  margin-bottom: 0;
}

.confirmation-action {
  width: 100%;
  margin-top: 24rpx;
}
