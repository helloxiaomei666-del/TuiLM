.security-page {
  padding-bottom: 136rpx;
}

.security-hero,
.security-form {
  padding: 28rpx;
}

.security-hero,
.security-form,
.impact-panel,
.security-group,
.security-field-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.summary-head,
.security-metrics,
.group-summary,
.security-field,
.security-category-tabs,
.security-submenu {
  display: flex;
}

.summary-head {
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.summary-main {
  flex: 1;
  min-width: 0;
}

.summary-label,
.summary-value,
.support-chip,
.impact-title,
.impact-copy,
.metric-label,
.metric-value,
.form-title,
.form-note,
.category-title,
.category-note,
.group-title,
.group-note,
.group-stat-label,
.group-stat-value,
.field-label {
  display: block;
}

.summary-label,
.metric-label,
.form-note,
.category-note,
.group-note,
.group-stat-label,
.impact-copy.muted {
  color: #61726d;
  font-size: 24rpx;
  line-height: 1.5;
}

.summary-value {
  color: #071916;
  font-size: 50rpx;
  font-weight: 950;
  line-height: 1.15;
  margin-top: 8rpx;
}

.support-chip {
  background: #e7f6ef;
  border: 1rpx solid #c7e7da;
  border-radius: 999rpx;
  color: #106044;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1;
  padding: 14rpx 18rpx;
  white-space: nowrap;
}

.impact-panel {
  background: #f6f8f7;
  border: 1rpx solid #e2ebe6;
  border-radius: 16rpx;
  padding: 22rpx;
}

.impact-title,
.form-title,
.group-title {
  color: #071916;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.35;
}

.impact-copy {
  color: #243632;
  font-size: 25rpx;
  font-weight: 750;
  line-height: 1.55;
}

.security-metrics,
.group-summary {
  flex-wrap: wrap;
  gap: 16rpx;
}

.security-metric,
.group-stat {
  background: #ffffff;
  border: 1rpx solid #e3ebe7;
  border-radius: 16rpx;
  box-sizing: border-box;
  min-width: 0;
  padding: 20rpx;
}

.security-metric {
  flex: 1 1 240rpx;
}

.security-metric.wide {
  flex-basis: 100%;
}

.metric-value,
.group-stat-value {
  color: #071916;
  font-size: 28rpx;
  font-weight: 950;
  line-height: 1.35;
  margin-top: 8rpx;
  word-break: break-all;
}

.security-form {
  margin-top: 20rpx;
}

.form-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.security-category-tabs {
  background: #f3f7f5;
  border: 1rpx solid #dfe9e4;
  border-radius: 16rpx;
  gap: 8rpx;
  padding: 8rpx;
}

.security-category-tab {
  border-radius: 12rpx;
  flex: 1;
  min-width: 0;
  padding: 18rpx 20rpx;
}

.security-category-tab.is-active {
  background: #071916;
}

.security-category-tab.is-active .category-title,
.security-category-tab.is-active .category-note {
  color: #ffffff;
}

.category-title {
  color: #071916;
  font-size: 29rpx;
  font-weight: 950;
  line-height: 1.25;
}

.category-note {
  margin-top: 5rpx;
}

.security-submenu {
  flex-wrap: wrap;
  gap: 12rpx;
}

.submenu-chip {
  background: #ffffff;
  border: 1rpx solid #dce7e2;
  border-radius: 999rpx;
  color: #48645d;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1;
  padding: 16rpx 20rpx;
}

.submenu-chip.is-active {
  background: #e6f3ee;
  border-color: #bfe3d5;
  color: #0f766e;
}

.security-group {
  background: #f9fbfa;
  border: 1rpx solid #dfe9e4;
  border-radius: 16rpx;
  padding: 22rpx;
}

.group-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.group-title-block {
  flex: 1;
  min-width: 0;
}

.group-note {
  margin-top: 6rpx;
}

.group-stat {
  flex: 1 1 190rpx;
}

.security-field-list {
  gap: 14rpx;
}

.security-field {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #e4ece8;
  border-radius: 16rpx;
  box-sizing: border-box;
  gap: 18rpx;
  min-height: 92rpx;
  padding: 18rpx 20rpx;
}

.field-label {
  color: #243632;
  flex: 1;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
  min-width: 0;
}

.security-field .form-input {
  background: #f4f7f6;
  border: 1rpx solid #dce7e2;
  border-radius: 14rpx;
  box-sizing: border-box;
  color: #071916;
  flex: 0 0 220rpx;
  font-size: 26rpx;
  font-weight: 850;
  height: 70rpx;
  min-width: 0;
  padding: 0 18rpx;
  text-align: right;
}
