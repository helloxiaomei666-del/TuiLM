.overview-page {
  padding: 34rpx 28rpx 0;
  padding-bottom: 136rpx;
  background: #f5f8f6;
}

.overview-brand {
  margin-bottom: 26rpx;
}

.brand-name,
.page-heading,
.update-text,
.section-kicker,
.phase-pill,
.progress-number,
.status-copy,
.stat-label,
.stat-value,
.risk-note,
.risk-link,
.section-title,
.route-summary,
.route-gap,
.node-label,
.advice-copy,
.focus-label,
.focus-value {
  display: block;
}

.brand-name {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
}

.page-heading {
  margin-top: 8rpx;
  color: #101918;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.16;
}

.update-text {
  margin-top: 10rpx;
  color: #61716b;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1.4;
}

.progress-card,
.route-preview-card,
.advice-card {
  border-radius: 16rpx;
  background: #ffffff;
}

.progress-card {
  margin-bottom: 18rpx;
  padding: 32rpx 30rpx 26rpx;
  box-shadow: 0 18rpx 42rpx rgba(16, 24, 40, 0.08);
}

.route-preview-card,
.advice-card {
  margin-bottom: 18rpx;
  padding: 26rpx;
  border: 1rpx solid #e5eeea;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.04);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-kicker,
.section-title {
  color: #101918;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

.phase-pill {
  flex: none;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #e9f4f0;
  color: #0f766e;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.35;
}

.progress-number {
  margin-top: 18rpx;
  color: #071916;
  font-size: 108rpx;
  font-weight: 700;
  line-height: 1;
}

.progress-track {
  width: 100%;
  height: 12rpx;
  margin: 18rpx 0 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e4ece8;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #0f766e;
}

.status-copy {
  color: #33423d;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.55;
}

.stat-row {
  display: flex;
  margin: 28rpx 0 24rpx;
  border-top: 1rpx solid #edf2ef;
  border-bottom: 1rpx solid #edf2ef;
}

.stat-item {
  flex: 1;
  min-width: 0;
  padding: 20rpx 12rpx;
}

.stat-item:first-child {
  padding-left: 0;
}

.stat-item:last-child {
  padding-right: 0;
}

.stat-label {
  color: #64736e;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.35;
}

.stat-value {
  margin-top: 8rpx;
  color: #101918;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.18;
  overflow-wrap: anywhere;
}

.primary-action,
.secondary-action,
.soft-action {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 88rpx;
}

.primary-action {
  border: 0;
  background: #071916;
  color: #ffffff;
}

.secondary-action {
  border: 1rpx solid #cfdcd7;
  background: #ffffff;
  color: #0f766e;
}

.soft-action {
  border: 0;
  background: #edf6f2;
  color: #0f766e;
}

.risk-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 18rpx;
}

.risk-note,
.risk-link {
  color: #68766f;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.45;
}

.risk-link {
  color: #0f766e;
}

.route-summary {
  margin-top: 12rpx;
  color: #33423d;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.55;
}

.route-summary.strong {
  margin-top: 2rpx;
  color: #101918;
  font-weight: 500;
}

.timeline-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin: 28rpx 0 22rpx;
  padding: 0 2rpx;
}

.timeline-node {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.node-dot {
  width: 13rpx;
  height: 13rpx;
  border: 2rpx solid #c6d5cf;
  border-radius: 999rpx;
  background: #ffffff;
}

.timeline-node.is-current .node-dot {
  border-color: #0f766e;
  background: #0f766e;
}

.node-label {
  margin-top: 10rpx;
  color: #64736e;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 1.25;
}

.route-gap {
  margin-bottom: 20rpx;
  color: #101918;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.35;
}

.advice-copy {
  margin-top: 12rpx;
  color: #33423d;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 1.55;
}

.advice-copy + .advice-copy {
  margin-top: 0;
}

.advice-focus {
  margin: 24rpx 0 22rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f8faf9;
}

.focus-label {
  color: #64736e;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1.35;
}

.focus-value {
  margin-top: 8rpx;
  color: #101918;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.35;
}
