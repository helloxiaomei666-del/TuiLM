<view class="page overview-page">
  <view class="overview-brand">
    <text class="brand-name">退了吗</text>
    <text class="page-heading">今天，你退休了吗？</text>
    <text class="update-text">本月更新：{{displayUpdatedDate}}</text>
  </view>

  <view class="progress-card">
    <view class="card-head">
      <text class="section-kicker">退休进度</text>
      <text class="phase-pill">{{overviewView.phaseLabel}}</text>
    </view>

    <text class="progress-number">{{overview.progressText}}</text>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{overview.progressWidth}}"></view>
    </view>

    <text class="status-copy">{{overviewView.statusCopyLine1}}</text>
    <text class="status-copy">{{overviewView.statusCopyLine2}}</text>

    <view class="stat-row">
      <view class="stat-item">
        <text class="stat-label">被动收入覆盖率</text>
        <text class="stat-value">{{overview.cashflowRetirementRateText}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">安全垫</text>
        <text class="stat-value">{{overview.runwayMonthsText}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">净资产</text>
        <text class="stat-value">{{overview.currentAssetsText}}</text>
      </view>
    </view>

    <button class="primary-action" data-page="route" bindtap="goTab">查看我的退休路线</button>
    <view class="risk-row">
      <text class="risk-note">结果仅基于填写数据估算，不构成投资建议。</text>
      <text class="risk-link" aria-label="隐私与免责声明" bindtap="openLegal">查看说明</text>
    </view>
  </view>

  <view class="route-preview-card">
    <text class="section-title">退休路线</text>
    <text class="route-summary">基于当前填写数据，</text>
    <text class="route-summary strong">{{routePreview.headline}}</text>

    <view class="timeline-row">
      <block wx:for="{{routePreview.nodes}}" wx:key="label">
        <view class="timeline-node {{item.className}}">
          <text class="node-dot"></text>
          <text class="node-label">{{item.label}}</text>
        </view>
      </block>
    </view>

    <text class="route-gap">{{routePreview.gapText}}</text>
    <button class="secondary-action" data-page="route" bindtap="goTab">查看路线详情</button>
  </view>

  <view class="advice-card">
    <text class="section-title">本月建议</text>
    <text class="advice-copy">先补充资产明细，</text>
    <text class="advice-copy">让退休进度估算更准确。</text>

    <view class="advice-focus">
      <text class="focus-label">当前最建议完善：</text>
      <text class="focus-value">资产数据 / 保障数据</text>
    </view>

    <button class="soft-action" data-page="assets" bindtap="goTab">去完善基础数据</button>
  </view>
</view>
